# Variables de entorno de Nuku OS — se cargan en Vercel (Project Settings →
# Environment Variables), nunca se suben al repo con valores reales.
#
# Esto es, literalmente, todo lo que cambia entre un cliente y otro a nivel
# de infraestructura: mismo código para todos, distintos valores acá.

# Supabase del proyecto (compartido multi-cliente: una fila en `accounts`
# por hostal, no un proyecto Supabase por cliente — ver ONBOARDING.md para
# la explicación de por qué y cuándo conviene lo contrario).
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Motor del Concierge IA. Se pide en console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# --- Por cliente/canal, dentro de n8n (no acá) ---
# Los tokens de WhatsApp Business API, Instagram Graph API, SMTP, etc. NO
# van en esta app: viven como credenciales dentro de cada workflow de n8n,
# uno por cliente. Ver n8n-templates/README.md.
